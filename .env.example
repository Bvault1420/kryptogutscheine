# ─── Bitrefill API ───
# Bitrefill (Node 22+: --use-system-ca für TLS; start-dev.bat / npm run dev setzen das)
BITREFILL_API_KEY=your_bitrefill_api_key_here
BITREFILL_API_BASE_URL=https://api-bitrefill.com/v2
BITREFILL_INCLUDE_TEST_PRODUCTS=true
# In Production Pflicht – sonst werden Webhooks abgelehnt
BITREFILL_WEBHOOK_SECRET=your_webhook_secret_here_min_32_chars

PORT=3002
NODE_ENV=development
FRONTEND_URL=http://127.0.0.1:5320,http://localhost:5320
# Mindestens 32 Zeichen – in Production Pflicht
CSRF_SECRET=change_me_to_a_random_string_at_least_32_chars
FORCE_HTTPS=false

# Admin-Endpoints (GET /api/orders, GET /api/analytics)
# Header: Authorization: Bearer <ADMIN_API_KEY>
ADMIN_API_KEY=change_me_to_another_random_string_at_least_32_chars
# Optional: Admin nur von diesen IPs (kommagetrennt)
# ADMIN_ALLOWED_IPS=127.0.0.1

# Order-Zugriff: Bei Rechnungserstellung wird accessToken zurückgegeben.
# Frontend sendet X-Order-Token (Header) bei GET /api/invoices/:id und /api/orders/:id

# Optional: Fehler-Monitoring (Sentry DSN o. ä.)
# MONITORING_DSN=

# SQLite-Datenbank (Standard: backend/data/redeemx.db)
# SQLITE_PATH=backend/data/redeemx.db

# Optional: SMTP für Newsletter-Bestätigung (sonst Link in Dev-UI)
# NEWSLETTER_SMTP_URL=smtp://user:pass@mail.example:587

# ─── Rate limits ───
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
RATE_LIMIT_INVOICE_MAX=20
RATE_LIMIT_PRODUCT_MAX=300
RATE_LIMIT_NEWSLETTER_MAX=5
RATE_LIMIT_TRACK_MAX=60
RATE_LIMIT_WEBHOOK_MAX=120

# ─── Product cache (ms) ───
CACHE_TTL_MS=900000
MAX_VOUCHER_AMOUNT=500
