# ─── Staging (Beispiel – Kopie als .env.staging) ───
NODE_ENV=production
PORT=3002
HOST=127.0.0.1
FRONTEND_URL=https://staging.kryptogutscheine.example

BITREFILL_API_KEY=your_staging_key
BITREFILL_WEBHOOK_SECRET=staging_webhook_secret_min_32_chars!!
BITREFILL_INCLUDE_TEST_PRODUCTS=true

CSRF_SECRET=staging_csrf_secret_at_least_32_chars_long
ADMIN_API_KEY=staging_admin_key_at_least_32_chars_long!!
ADMIN_ALLOWED_IPS=127.0.0.1

FORCE_HTTPS=false
MONITORING_DSN=

# SQLite (Standard: backend/data/redeemx.db)
# SQLITE_PATH=/var/lib/redeemx/redeemx.db
