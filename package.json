{
  "name": "redeemx",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RedeemX – Gutschein-Vermittlungsplattform (keine Finanzdienstleistung)",
  "scripts": {
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "dev": "node scripts/dev.mjs",
    "localhost": "node scripts/dev.mjs",
    "dev:simple": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "test": "npm test --prefix backend",
    "pentest": "node scripts/pentest.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "start": "npm run start --prefix backend",
    "start:prod": "npm run build && cross-env NODE_ENV=production npm run start --prefix backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3"
  }
}
